{
  "schemaVersion": 1,
  "description": "P0 探测契约：读取最近业务事件、调用宿主只读接口并返回字段摘要。",
  "models": {
    "empty": {
      "type": "null",
      "description": "无参数请求。"
    },
    "probeEvents": {
      "type": "object",
      "description": "事件计数与最近事件列表。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "probeApi": {
      "type": "object",
      "description": "宿主接口探测结果。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "connectProbe": {
      "type": "object",
      "description": "单个会话的实时事件探测。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "sessionInput": {
      "type": "object",
      "description": "要观察的会话 ID。",
      "properties": {
        "sessionId": { "type": "string", "description": "宿主会话 ID。", "minLength": 1, "maxLength": 200 },
        "waitMs": { "type": "integer", "description": "观察时长，毫秒，1000-30000。", "minimum": 1000, "maximum": 30000 }
      },
      "required": ["sessionId"],
      "additionalProperties": false
    }
  },
  "rpc": {
    "probe-events": {
      "description": "返回事件类型计数与最近事件样本。",
      "input": "empty",
      "output": "probeEvents"
    },
    "probe-api": {
      "description": "调用会话、用量、技能等只读接口并返回摘要。",
      "input": "empty",
      "output": "probeApi"
    },
    "probe-reset": {
      "description": "清空事件缓冲。",
      "input": "empty",
      "output": "empty"
    },
    "probe-connect": {
      "description": "连接指定会话，采样一段时间内的实时事件类型。",
      "input": "sessionInput",
      "output": "connectProbe"
    }
  },
  "tools": {},
  "commands": {},
  "actions": {},
  "events": {},
  "storage": {},
  "checkpoints": {}
}
