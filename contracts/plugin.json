{
  "schemaVersion": 1,
  "description": "HALOFLUX AI LINK 看板：一次读取聚合快照，以及当前用户的显示设置。",
  "models": {
    "empty": {
      "type": "null",
      "description": "无参数请求。"
    },
    "snapshot": {
      "type": "object",
      "description": "看板快照：会话、Agent、思考流、任务计划、工具、用量、本机指标。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "description": "当前用户的显示设置。",
      "properties": {
        "anim": {
          "type": "boolean",
          "description": "显示原版动效舞台；默认 true。"
        },
        "fps": {
          "type": "integer",
          "description": "舞台帧率上限：30 或 60；默认 30。",
          "enum": [
            30,
            60
          ]
        },
        "display": {
          "type": "string",
          "description": "显示方式：iframe 内嵌，或 link 新链接。",
          "enum": [
            "iframe",
            "link"
          ]
        },
        "url": {
          "type": "string",
          "description": "link 模式打开的地址（可带访问令牌）；空则不跳转。",
          "maxLength": 2048
        }
      },
      "required": [
        "anim",
        "fps",
        "display",
        "url"
      ],
      "additionalProperties": false
    },
    "saved": {
      "type": "object",
      "description": "设置已持久化。",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "成功时为 true。",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "description": "docker 版 /stats 兼容结构，供原版 ai-link.js 渲染。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "rpc": {
    "snapshot": {
      "description": "读取看板快照；页面轮询调用。",
      "input": "empty",
      "output": "snapshot"
    },
    "get-settings": {
      "description": "读取当前用户的显示设置。",
      "input": "empty",
      "output": "settings"
    },
    "save-settings": {
      "description": "保存当前用户的显示设置。",
      "input": "settings",
      "output": "saved"
    },
    "stats": {
      "description": "返回 /stats 兼容快照。",
      "input": "empty",
      "output": "stats"
    }
  },
  "tools": {},
  "commands": {},
  "actions": {},
  "events": {},
  "storage": {},
  "checkpoints": {}
}