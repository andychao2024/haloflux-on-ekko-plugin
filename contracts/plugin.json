{
  "schemaVersion": 1,
  "description": "HALOFLUX ON Ekko 看板：一次读取聚合快照，以及当前用户的显示设置。",
  "models": {
    "empty": {
      "type": "null",
      "description": "无参数请求。"
    },
    "snapshot": {
      "type": "object",
      "description": "看板快照：会话、Agent、思考流、任务计划、工具、用量、本机指标。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "description": "当前用户的显示设置。",
      "properties": {
        "anim": {
          "type": "boolean",
          "description": "显示原版动效舞台；默认 true。"
        },
        "compat": {
          "type": "boolean",
          "description": "兼容模式：DPR 固定 1、禁用 will-change，缓解旧显卡闪烁；默认 false。"
        },
        "gpu": {
          "type": "boolean",
          "description": "在看板里显示显卡（GPU）曲线与显存信息；默认 true。"
        },
        "showIcon": {
          "type": "boolean",
          "description": "在 Studio 侧栏显示插件入口图标；默认 true。"
        },
        "toolRows": {
          "type": "integer",
          "description": "工具调用面板显示的条数；默认 8，最小 3，最大 15。超出范围的取值按边界保存。",
          "minimum": 3,
          "maximum": 15
        },
        "agentRows": {
          "type": "integer",
          "description": "代理调度面板显示的行数；默认 8，最小 3，最大 12。超出范围的取值按边界保存。",
          "minimum": 3,
          "maximum": 12
        },
        "title": {
          "type": "string",
          "description": "看板左上角标题；空字符串使用默认标题。",
          "maxLength": 80
        },
        "music": {
          "type": "boolean",
          "description": "启用背景音乐；默认 false。开启后第一次点击页面开始播放。"
        },
        "wallpaper": {
          "type": "boolean",
          "description": "启用独立端口的壁纸服务；默认 false。"
        },
        "wallpaperPort": {
          "type": "integer",
          "description": "壁纸服务端口；默认 8790，范围 1024–65535。",
          "minimum": 1024,
          "maximum": 65535
        },
        "wallpaperToken": {
          "type": "string",
          "description": "壁纸服务访问密钥；首次安装随机生成，可在设置中修改。",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "agentRows",
        "anim",
        "compat",
        "gpu",
        "showIcon",
        "title",
        "toolRows",
        "music",
        "wallpaper",
        "wallpaperPort",
        "wallpaperToken"
      ],
      "additionalProperties": false
    },
    "saved": {
      "type": "object",
      "description": "设置已持久化。",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "成功时为 true。",
          "enum": [
            true
          ]
        },
        "navSynced": {
          "type": "boolean",
          "description": "侧栏入口是否已同步为当前开关状态；宿主拒绝导航写入时为 false。"
        },
        "wallpaperError": {
          "type": "string",
          "description": "壁纸服务启动失败原因；空字符串表示正常。"
        },
        "wallpaperToken": {
          "type": "string",
          "description": "保存后的访问密钥；空输入时会重新生成。",
          "minLength": 1
        }
      },
      "required": [
        "navSynced",
        "ok",
        "wallpaperError",
        "wallpaperToken"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "description": "当前用户的侧栏入口同步结果。",
      "properties": {
        "showIcon": {
          "type": "boolean",
          "description": "保存的侧栏入口开关。"
        },
        "synced": {
          "type": "boolean",
          "description": "侧栏入口是否已与开关一致。"
        }
      },
      "required": [
        "showIcon",
        "synced"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "description": "docker 版 /stats 兼容结构，供原版 ai-link.js 渲染。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "rate": {
      "type": "object",
      "description": "最近 20 秒的令牌吞吐与缓存命中率。",
      "properties": {
        "tokensPerSec": {
          "type": "number",
          "description": "每秒令牌数（输入+输出+缓存读）。"
        },
        "outputPerSec": {
          "type": "number",
          "description": "每秒输出令牌数。"
        },
        "cacheHit": {
          "type": "number",
          "description": "缓存命中率百分比。",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "tokensPerSec",
        "outputPerSec",
        "cacheHit"
      ],
      "additionalProperties": false
    }
  },
  "rpc": {
    "snapshot": {
      "description": "读取看板快照；页面轮询调用。",
      "input": "empty",
      "output": "snapshot"
    },
    "get-settings": {
      "description": "读取当前用户的显示设置。",
      "input": "empty",
      "output": "settings"
    },
    "save-settings": {
      "description": "保存当前用户的显示设置。",
      "input": "settings",
      "output": "saved"
    },
    "ensure-navigation": {
      "description": "按当前开关把插件入口同步到 Studio 侧栏；页面挂载时调用。",
      "input": "empty",
      "output": "navigation"
    },
    "stats": {
      "description": "返回 /stats 兼容快照。",
      "input": "empty",
      "output": "stats"
    },
    "rate": {
      "description": "刷新并读取当前令牌吞吐；由页面独立轮询，避免阻塞 stats。",
      "input": "empty",
      "output": "rate"
    }
  },
  "tools": {},
  "commands": {},
  "actions": {},
  "events": {},
  "storage": {},
  "checkpoints": {}
}
