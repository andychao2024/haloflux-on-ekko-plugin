{
  "schemaVersion": 1,
  "description": "HALOFLUX AI LINK 看板：一次读取聚合快照，以及当前用户的显示设置。",
  "models": {
    "empty": {
      "type": "null",
      "description": "无参数请求。"
    },
    "snapshot": {
      "type": "object",
      "description": "看板快照：会话、Agent、思考流、任务计划、工具、用量、本机指标。",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "description": "当前用户的显示设置。",
      "properties": {
        "compact": { "type": "boolean", "description": "紧凑布局；默认 false。" }
      },
      "required": ["compact"],
      "additionalProperties": false
    },
    "saved": {
      "type": "object",
      "description": "设置已持久化。",
      "properties": { "ok": { "type": "boolean", "description": "成功时为 true。", "enum": [true] } },
      "required": ["ok"],
      "additionalProperties": false
    }
  },
  "rpc": {
    "snapshot": {
      "description": "读取看板快照；页面轮询调用。",
      "input": "empty",
      "output": "snapshot"
    },
    "get-settings": {
      "description": "读取当前用户的显示设置。",
      "input": "empty",
      "output": "settings"
    },
    "save-settings": {
      "description": "保存当前用户的显示设置。",
      "input": "settings",
      "output": "saved"
    }
  },
  "tools": {},
  "commands": {},
  "actions": {},
  "events": {},
  "storage": {},
  "checkpoints": {}
}
